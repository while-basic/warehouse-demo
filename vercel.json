{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/items", "destination": "/api/items" },
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/sap-sync", "destination": "/api/sap-sync" },
    { "source": "/api/symmetry", "destination": "/api/symmetry" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
